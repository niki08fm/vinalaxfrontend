# Website backend base URL. Leave unset in production: the site then calls
# /site-api, which vercel.json forwards to the backend on AWS EC2.
# Local dev (vinalaxbackend running on port 5002):
VITE_API_BASE_URL=http://localhost:5002/api

# Client portal (HR software). Default: https://portal.vinalaxhrsolutions.com
# VITE_CLIENT_PORTAL_URL=https://portal.vinalaxhrsolutions.com
